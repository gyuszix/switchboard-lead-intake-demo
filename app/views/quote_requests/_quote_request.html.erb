<%# locals: (quote_request:) %>
<tr id="<%= dom_id(quote_request) %>">
  <td><%= quote_request.carrier %></td>
  <td><%= QuoteRequest::CHANNEL_LABELS[quote_request.channel] %></td>
  <td><span class="badge status-<%= quote_request.status %>"><%= quote_request.status.humanize %></span></td>
  <td><%= number_to_currency(quote_request.premium, precision: 0) if quote_request.premium %></td>
  <td><%= quote_request.reference %></td>
  <td>
    <%= quote_request.message %>
    <% if quote_request.channel == "api" && quote_request.request_body.present? %>
      <details class="exchange">
        <summary>Sent / received</summary>
        <div class="exchange-label">Sent</div>
        <pre><%= quote_request.request_body %></pre>
        <div class="exchange-label">Received</div>
        <pre><%= quote_request.response_body.presence || "Nothing received" %></pre>
      </details>
    <% elsif quote_request.channel == "portal" && (sent = quote_request.request_data) %>
      <%= render "quote_requests/portal_record", sent: sent, received: quote_request.response_data %>
    <% elsif quote_request.channel == "email" && (sent = quote_request.request_data) %>
      <%= render "quote_requests/email_record", quote_request: quote_request, sent: sent %>
    <% end %>
  </td>
  <td class="counter"><%= quote_request.created_at&.strftime("%H:%M:%S") %></td>
</tr>

<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Lead Intake" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <%= link_to "Lead Intake", root_path, class: "brand" %>
    </header>
    <main class="container">
      <%= yield %>
    </main>
    <%= render "layouts/pipeline", pipeline: pipeline_state %>
  </body>
</html>

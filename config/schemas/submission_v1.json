{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/submission_v1.json",
  "title": "Commercial insurance submission v1",
  "description": "Broker-approved submission record. Checks format only; value checks stay in the review stage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "built_at",
    "applicant",
    "operations",
    "coverage",
    "contact"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "submission_id": {
      "type": "integer",
      "minimum": 1
    },
    "built_at": {
      "type": "string",
      "format": "date-time"
    },
    "applicant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "business_name",
        "fein",
        "address",
        "zip",
        "years_in_business"
      ],
      "properties": {
        "business_name": {
          "type": "string",
          "minLength": 1
        },
        "fein": {
          "type": "string",
          "pattern": "^\\d{2}-\\d{7}$"
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "zip": {
          "type": "string",
          "pattern": "^\\d{5}$"
        },
        "years_in_business": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "industry_description",
        "naics_code",
        "annual_revenue",
        "employee_count"
      ],
      "properties": {
        "industry_description": {
          "type": "string",
          "minLength": 1
        },
        "naics_code": {
          "type": "string",
          "pattern": "^\\d{6}$"
        },
        "annual_revenue": {
          "type": "integer",
          "minimum": 1
        },
        "employee_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_types",
        "effective_date"
      ],
      "properties": {
        "coverage_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "effective_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contact_name",
        "contact_email"
      ],
      "properties": {
        "contact_name": {
          "type": "string",
          "minLength": 1
        },
        "contact_email": {
          "type": "string",
          "format": "email"
        }
      }
    }
  }
}
